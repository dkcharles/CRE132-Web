<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Drops ~2.5 MB of ICU data AND pins '.' as the decimal separator whatever locale
         the visitor's browser reports. Challenge expected-output matching depends on it. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.30" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\Harness\Harness.csproj" />
    <ProjectReference Include="..\..\engine\Compiler\Compiler.csproj" />
  </ItemGroup>

  <!-- Not downloaded until the student presses Run on edited code. Reading pages never
       triggers it, so a first visit stays small. -->
  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="Microsoft.CodeAnalysis.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Microsoft.CodeAnalysis.CSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Compiler.wasm" />

    <!-- Roslyn's own dependencies. Without these the compiler is lazy but everything it needs
         is not, and the first visit pays for a compiler it never loads. -->
    <BlazorWebAssemblyLazyLoad Include="System.Collections.Immutable.wasm" />
    <BlazorWebAssemblyLazyLoad Include="System.Reflection.Metadata.wasm" />
    <BlazorWebAssemblyLazyLoad Include="System.Text.Encoding.CodePages.wasm" />
    <BlazorWebAssemblyLazyLoad Include="System.Private.Xml.wasm" />
    <!-- System.Text.RegularExpressions must stay EAGER: Blazor's Router needs it at boot
         (RegexRouteConstraint). Lazy-loading it broke startup outright. -->
  </ItemGroup>

  <Import Project="CopyReferences.targets" />

</Project>
