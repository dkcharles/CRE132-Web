@namespace CRE132.Web.Pages
@using CRE132.Engine
@implements IDisposable
@inject CompilerLoader Compiler
@inject LocalStore Store

<div class="challenge">
    <div class="challenge-task">
        <span class="label">CHALLENGE</span>
        @((MarkupString)TaskHtml)
    </div>
    <CodeEditor @ref="editor" EditorId="@("challenge-" + ChallengeId)" InitialText="@buffer" />
    @* Same panel as a sample's: ▶ Run feeds it to the program's Console.ReadLine() calls.
       Check ignores it - the cases supply their own input. Only shown when the challenge
       actually reads something, prefilled with the first test's input so Run works untouched. *@
    @if (ReadsInput)
    {
        <details>
            <summary>Input — one line per <code>Console.ReadLine()</code> (used by ▶ Run)</summary>
            <textarea class="stdin" rows="3" @bind="input"></textarea>
        </details>
    }
    <GameStage @ref="stage" />
    <div class="controls">
        <button @onclick="ResetAsync" disabled="@busy">Reset</button>
        <button @onclick="RunAsync" disabled="@busy">
            @(Compiler.IsLoading ? "Downloading compiler…" : busy && !checking ? "Working…" : "▶ Run")
        </button>
        <button @onclick="CheckAsync" disabled="@busy">
            @(Compiler.IsLoading ? "Downloading compiler…" : checking ? "Checking…" : "Check")
        </button>
    </div>
    @if (errors is { Count: > 0 })
    {
        <ul class="errors">
            @foreach (var e in errors) { <li>Line @e.Line: @e.Message <span class="error-id">(@e.Id)</span></li> }
        </ul>
    }
    @if (notice is not null) { <p class="notice">@notice</p> }
    @if (runOutput is not null)
    {
        <div class="pane">
            <div class="pane-label">Your program's output</div>
            <pre class="console">@ConsoleLines.Shown(runOutput, showAll)</pre>
        </div>
        @if (!showAll && ConsoleLines.IsCapped(runOutput))
        {
            <button class="show-all" @onclick="() => showAll = true">Show all @ConsoleLines.Count(runOutput) lines</button>
        }
    }
    @if (runError is not null) { <p class="run-error">@runError</p> }
    @if (results is not null)
    {
        @if (results.All(r => r.Passed))
        {
            <p class="verdict pass">✓ Passed! @(results.Any(r => r.Frames is { Count: > 0 }) ? "Your game matched" : "Your output matches") on @(results.Count == 1 ? "the test" : $"all {results.Count} tests").</p>
            @foreach (CaseResult r in results)
            {
                @if (r.ActualLines.Count > 0)
                {
                    <div class="pane">
                        <div class="pane-label">@(results.Count == 1 ? "Your output" : $"Test {r.Index} — your output")@(r.Input.Length > 0 ? " (input: " + r.Input.TrimEnd() + ")" : "")</div>
                        <div class="console">
                            @foreach (string line in r.ActualLines)
                            {
                                <div class="line">@line</div>
                            }
                        </div>
                    </div>
                }
            }
        }
        else
        {
            CaseResult failed = results.First(r => !r.Passed);
            <p class="verdict fail">✗ Not yet — test @failed.Index didn't match.</p>
            @if (failed.Input.Length > 0) { <p class="case-input">Input given: <code>@failed.Input.TrimEnd()</code></p> }
            @if (failed.Error is not null) { <p class="run-error">@failed.Error</p> }
            else if (failed.Frames?.FirstOrDefault(f => !f.Passed) is FrameCheck frame)
            {
                <p class="case-input">Frame @frame.Frame didn't match. Each row is 16 pixels; <code>#</code> rect, <code>o</code> circle, <code>+</code> line, letters are text.</p>
                <div class="diff">
                    <div class="pane">
                        <div class="pane-label">Your frame @frame.Frame</div>
                        @* A frame the program never reached has no grid to show: say so, rather than
                           drawing an empty box and highlighting a row that does not exist. *@
                        @if (Missing(frame))
                        {
                            <div class="console grid">
                                <div class="line">(no frame — your program stopped before frame @frame.Frame)</div>
                            </div>
                        }
                        else
                        {
                            <div class="console grid">
                                @for (int i = 0; i < frame.ActualRows.Count; i++)
                                {
                                    <div class="line @(i + 1 == frame.FirstDiffRow ? "diff-line" : "")">@frame.ActualRows[i]</div>
                                }
                            </div>
                        }
                    </div>
                    <div class="pane">
                        <div class="pane-label">Expected frame @frame.Frame</div>
                        <div class="console grid">
                            @for (int i = 0; i < frame.ExpectedRows.Count; i++)
                            {
                                <div class="line @(!Missing(frame) && i + 1 == frame.FirstDiffRow ? "diff-line" : "")">@frame.ExpectedRows[i]</div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="diff">
                    <div class="pane">
                        <div class="pane-label">Your output</div>
                        <div class="console">
                            @for (int i = 0; i < failed.ActualLines.Count; i++)
                            {
                                <div class="line @(i + 1 == failed.FirstDiffLine ? "diff-line" : "")">@failed.ActualLines[i]</div>
                            }
                        </div>
                    </div>
                    <div class="pane">
                        <div class="pane-label">Expected</div>
                        <div class="console">
                            @for (int i = 0; i < failed.ExpectedLines.Count; i++)
                            {
                                <div class="line @(i + 1 == failed.FirstDiffLine ? "diff-line" : "")">@failed.ExpectedLines[i]</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }
    @* Help unlocks with failed Checks - a hint after the first, the solution after the third -
       and goes away once the latest Check passes. Only a Check on changed code counts, so
       pressing Check three times on the same program does not hand over the answer. *@
    @if (!Solved && (HintUnlocked || SolutionUnlocked))
    {
        <div class="help">
            @if (HintUnlocked && !showHint) { <button class="help-link" @onclick="() => showHint = true">Show a hint</button> }
            @if (SolutionUnlocked && !showSolution) { <button class="help-link" @onclick="() => showSolution = true">Show the solution</button> }
        </div>
        @if (HintUnlocked && showHint)
        {
            <aside class="callout hint"><span class="label">HINT</span>@((MarkupString)Hint!)</aside>
        }
        @if (SolutionUnlocked && showSolution)
        {
            <div class="pane">
                <div class="pane-label">
                    One solution
                    <button @onclick="CopySolutionAsync" disabled="@busy">Copy into the editor</button>
                </div>
                <pre class="listing"><code>@((MarkupString)SolutionHtml)</code></pre>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string ChallengeId { get; set; } = default!;
    [Parameter, EditorRequired] public string TaskHtml { get; set; } = default!;
    [Parameter, EditorRequired] public string Starter { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ChallengeCase> Cases { get; set; } = default!;
    [Parameter, EditorRequired] public string Solution { get; set; } = default!;      // raw: what "Copy into the editor" pastes
    [Parameter, EditorRequired] public string SolutionHtml { get; set; } = default!;  // highlighted: what is shown
    [Parameter] public string? Hint { get; set; }                                     // rendered hint.md; null when the kit has none

    CodeEditor? editor;
    GameStage? stage;
    string buffer = "";
    string input = "";        // what ▶ Run gives Console.ReadLine(); starts as the first case's input
    string? notice, runOutput, runError;
    IReadOnlyList<CompileError>? errors;
    IReadOnlyList<CaseResult>? results;
    bool busy, checking;      // checking keeps Run and Check from both claiming to be checking
    bool showAll;             // the output pane shows the last 200 lines until asked for the rest
    int attempts;             // failed Checks on distinct code; persisted so a reload does not reset it
    string? lastAttempt;      // fingerprint of the code the last counted attempt was made on
    bool showHint, showSolution;

    string StoreKey => "challenge." + ChallengeId;
    string AttemptsKey => StoreKey + ".attempts";
    bool ReadsInput => Cases.Any(c => c.Input.Length > 0);
    bool Solved => results is not null && results.All(r => r.Passed);
    bool HintUnlocked => Hint is not null && attempts >= 1;
    bool SolutionUnlocked => attempts >= 3;

    // The checker reports a frame that was never rendered as a single blank row, with row 1
    // flagged as the difference; an empty grid and a stray highlight would both mislead.
    static bool Missing(FrameCheck f) =>
        f.ActualRows.Count == 0 || (f.ActualRows.Count == 1 && f.ActualRows[0].Length == 0);

    protected override async Task OnInitializedAsync()
    {
        Compiler.StateChanged += StateHasChanged;
        input = Cases[0].Input;
        buffer = await Store.LoadAsync(StoreKey, SourceText.Fingerprint(Starter)) ?? Starter;
        // "<count>\n<fingerprint>", against the starter's fingerprint like the buffer itself, so
        // a re-authored challenge starts everyone back at zero.
        string? saved = await Store.LoadAsync(AttemptsKey, SourceText.Fingerprint(Starter));
        if (saved?.Split('\n') is [string count, string fingerprint] && int.TryParse(count, out int n))
        {
            attempts = n;
            lastAttempt = fingerprint;
        }
    }

    // Run is Check without the marking: the student's own program on whatever the input panel
    // holds (the first case's input until they edit it), playing on the stage when it is a game.
    async Task RunAsync()
    {
        busy = true; errors = null; results = null; notice = null; runOutput = null; runError = null;
        showAll = false;
        try
        {
            buffer = await editor!.GetTextAsync();
            await Store.SaveAsync(StoreKey, buffer, SourceText.Fingerprint(Starter));

            CompiledBytes compiled = await Compiler.CompileToBytesAsync(buffer);
            if (!compiled.Succeeded)
            {
                errors = compiled.Errors;
                await editor.SetErrorsAsync(errors!);
                return;
            }

            GameSession session = GameSession.Start(ProgramLoader.FromBytes(compiled.Bytes!), input ?? "");
            if (session.IsGame) { await stage!.PlayAsync(session); }
            else
            {
                await stage!.ClearAsync();
                runOutput = session.Result.Output;
                runError = session.Result.Error;
            }
            await editor.SetErrorsAsync(Array.Empty<CompileError>());
        }
        // The compiler could not be fetched. Almost always a deploy landing under an open
        // page, which no retry fixes - so it gets its own sentence, before the general one.
        catch (CompilerUnavailableException ex) { notice = ex.Message; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException
                                      or Microsoft.JSInterop.JSException)
        {
            notice = "Could not reach the site just now — check your connection and press Run again.";
        }
        finally { busy = false; }
    }

    async Task CheckAsync()
    {
        busy = true; checking = true; errors = null; results = null; notice = null; runOutput = null; runError = null;
        showAll = false;
        try
        {
            // Marking runs the program again headless: a stage still playing would be a second
            // copy of the program competing for the same screen. Inside the try, so an unfiltered
            // failure here cannot leave Run and Check disabled until the page is reloaded.
            await stage!.StopAsync();
            buffer = await editor!.GetTextAsync();
            await Store.SaveAsync(StoreKey, buffer, SourceText.Fingerprint(Starter));

            CompiledBytes compiled = await Compiler.CompileToBytesAsync(buffer);
            if (!compiled.Succeeded)
            {
                errors = compiled.Errors;
                await editor.SetErrorsAsync(errors!);
                await RecordAttemptAsync();
                return;
            }

            // Everything the student's own program can do is caught inside the checker, but the
            // renderer runs outside that catch and outside the frame budget. A bug there must
            // read as a message under the buttons, never as Blazor's unhandled-error banner,
            // which kills the circuit and takes the whole page with it.
            // Check is pure CPU - no network, no JS - so nothing here belongs to the outer filter.
            try { results = ChallengeChecker.Check(compiled.Bytes!, Cases); }
            catch (Exception)
            {
                notice = "Something went wrong while checking your program — please tell your tutor what you typed.";
                return;
            }
            await editor.SetErrorsAsync(Array.Empty<CompileError>());
            if (!Solved) await RecordAttemptAsync();
        }
        catch (CompilerUnavailableException ex) { notice = ex.Message; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException
                                      or Microsoft.JSInterop.JSException)
        {
            notice = "Could not reach the site just now — check your connection and press Check again.";
        }
        finally { busy = false; checking = false; }
    }

    async Task ResetAsync()
    {
        buffer = Starter;
        input = Cases[0].Input;
        await editor!.SetTextAsync(Starter);
        await stage!.ClearAsync();
        errors = null; results = null; notice = null; runOutput = null; runError = null; showAll = false;
        attempts = 0; lastAttempt = null; showHint = false; showSolution = false;
        await Store.ClearAsync(StoreKey);
        await Store.ClearAsync(AttemptsKey);
    }

    // A failed Check counts once per distinct program: the same code checked again is the same
    // attempt. A store failure here must not turn a plain "not yet" into an error banner.
    async Task RecordAttemptAsync()
    {
        string fingerprint = SourceText.Fingerprint(buffer);
        if (fingerprint == lastAttempt) return;
        lastAttempt = fingerprint;
        attempts++;
        try { await Store.SaveAsync(AttemptsKey, $"{attempts}\n{lastAttempt}", SourceText.Fingerprint(Starter)); }
        catch (Microsoft.JSInterop.JSException) { }
    }

    // The shown solution, pasted over whatever is in the editor. Saved like any other edit, so
    // it is still there after a reload; Check on it passes and the help offers go away.
    async Task CopySolutionAsync()
    {
        buffer = Solution;
        await editor!.SetTextAsync(Solution);
        await editor.SetErrorsAsync(Array.Empty<CompileError>());
        await stage!.ClearAsync();
        errors = null; results = null; notice = null; runOutput = null; runError = null;
        await Store.SaveAsync(StoreKey, buffer, SourceText.Fingerprint(Starter));
    }

    public void Dispose() => Compiler.StateChanged -= StateHasChanged;
}
