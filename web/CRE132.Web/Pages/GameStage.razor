@namespace CRE132.Web.Pages
@using CRE132.Engine
@using CRE132.Game
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The canvas, its Stop button and the console under it. One stage plays at a time on a page:
   starting this one stops whichever was playing. The loop is a C# timer, not requestAnimationFrame,
   so Stop, Dispose and errors all live on the .NET side. *@
<div class="stage @(session is { IsGame: true } ? "" : "hidden")">
    @* The overlay must cover the CANVAS, not the whole stage (the console and buttons below
       stay readable while paused), so canvas and overlay share their own positioned box. *@
    <div class="stage-box">
        <canvas @ref="canvas" class="stage-canvas"></canvas>
        @if (paused) { <div class="stage-paused">Paused — come back to this tab to continue</div> }
    </div>
    <div class="stage-controls">
        @if (IsPlaying) { <button @onclick="StopAsync">■ Stop</button> }
        else if (session is { IsGame: true })
        {
            @* Either a way back or a sentence about one, never both. A lesson page's Run
               button is the way back already, so it passes no OnReplay and this row stays
               exactly as it was: the hint, pointing at that button. The landing page's preview
               starts itself and has no Run button anywhere, so it passes a handler and gets the
               button - and the hint there would be pointing at a Run that does not exist.
               Stopped, finished and errored all reach here: a game that ended is as replayable
               as one that was stopped. *@
            @if (OnReplay.HasDelegate) { <button class="replay" @onclick="() => OnReplay.InvokeAsync()">▶ Run again</button> }
            else { <span class="stage-hint">@(error is null ? "Stopped — press Run to play again." : "")</span> }
        }
    </div>
    @if (notice is not null) { <p class="notice">@notice</p> }
    @if (lines.Count > 0)
    {
        <div class="console stage-console">
            @foreach (string line in lines) { <div class="line">@line</div> }
        </div>
    }
    @if (error is not null) { <p class="run-error">@error</p> }
</div>

@code {
    const int ShownLines = 200;
    static GameStage? active;

    // Optional: a host that has no Run button of its own supplies the restart itself, and the
    // stage renders ▶ Run again for it while it is not playing. The stage never restarts a
    // session by itself - only the host knows what a fresh run of its program means.
    [Parameter] public EventCallback OnReplay { get; set; }

    ElementReference canvas;
    IJSObjectReference? game, input;
    GameSession? session;
    CancellationTokenSource? loop;          // the CURRENT loop; a superseded one sees loop != its own cts
    Task? loopTask;
    List<string> lines = new();
    string? error, notice;
    int consoleLength;
    bool paused;                            // the tab is hidden: the timer ticks, the game does not
    DotNetObjectReference<GameStage>? self; // handed to input.js so it can report tab visibility

    public bool IsPlaying { get; private set; }

    sealed class Snapshot
    {
        public string[] Keys { get; set; } = Array.Empty<string>();
        public int MouseX { get; set; }
        public int MouseY { get; set; }
        public bool MouseDown { get; set; }
    }

    public async Task PlayAsync(GameSession s)
    {
        if (active is not null && active != this) await active.StopAsync();
        await StopAsync();
        active = this;
        session = s; error = null; notice = null; consoleLength = 0; paused = false;
        lines = Tail(s.ConsoleText);
        // Setup threw: show why, and blank the canvas so the previous run's last frame is not
        // left sitting under an error message as if this program had drawn it.
        if (s.Stopped)
        {
            error = s.StopReason;
            StateHasChanged();
            try
            {
                game ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/game.js");
                await game.InvokeVoidAsync("reset", canvas, s.Width, s.Height);
            }
            catch (JSException) { }
            StateHasChanged();
            return;
        }

        try
        {
            game ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/game.js");
            input ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/input.js");
            StateHasChanged();                     // the canvas must be visible before JS sizes it
            await game.InvokeVoidAsync("reset", canvas, s.Width, s.Height);
            await input.InvokeVoidAsync("attach", canvas, s.Width, s.Height);
            // After attach, so a stage that failed to start never registers. input.js keeps one
            // document listener and only the newest reference, and release() drops it - so the
            // stage that is playing is the only one a tab switch can reach.
            self ??= DotNetObjectReference.Create(this);
            await input.InvokeVoidAsync("onVisibility", self);
        }
        catch (JSException)
        {
            notice = "The game display could not start — reload the page and try again.";
            StateHasChanged();
            return;
        }

        IsPlaying = true;
        var cts = new CancellationTokenSource();
        loop = cts;
        loopTask = LoopAsync(cts);
        StateHasChanged();
    }

    // Every resumption re-checks that this loop is still the current one. Cancellation resumes a
    // continuation asynchronously, so a Run pressed while a game plays can start the next loop
    // before this one's tail runs; without the check that tail would step the NEW session, clear
    // IsPlaying under a playing game and release the keyboard mid-play.
    async Task LoopAsync(CancellationTokenSource cts)
    {
        bool Current() => ReferenceEquals(loop, cts);
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(1000.0 / Frame.Rate));
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                if (!Current()) return;
                // Paused keeps ticking but skips Step and the frame, so nothing moves while the
                // student is in another tab and Frame.Count picks up where it left off rather
                // than jumping by however many seconds they were away.
                if (paused) continue;
                Snapshot snap = await input!.InvokeAsync<Snapshot>("snapshot");
                if (!Current()) return;
                // Escape stops the game from the keyboard, for a student whose program has
                // filled the screen or taken the arrow keys. Breaking out rather than calling
                // StopAsync: StopAsync awaits the running loop, which here is THIS one, so it
                // would wait on itself forever. The finally below is the same teardown.
                if (snap.Keys.Contains("Escape")) break;
                var down = new HashSet<Key>();
                foreach (string k in snap.Keys) if (Enum.TryParse(k, out Key key)) down.Add(key);
                FrameResult f = session!.Step(new InputState(down, snap.MouseX, snap.MouseY, snap.MouseDown));

                await game!.InvokeVoidAsync("frame", canvas, session.Width, session.Height, Flatten(f.Commands));
                if (!Current()) return;

                bool changed = f.Console.Length != consoleLength || f.Error is not null;
                consoleLength = f.Console.Length;
                if (changed) { lines = Tail(f.Console); error = f.Error; await InvokeAsync(StateHasChanged); }
                if (f.Error is not null) break;
            }
        }
        catch (OperationCanceledException) { }
        catch (JSException) { if (Current()) notice = "The game display stopped responding — press Run to try again."; }
        finally
        {
            // A loop that ends on its own owns the teardown; a superseded one leaves the live
            // stage alone, because StopAsync already did (or is about to do) the teardown itself.
            if (Current())
            {
                loop = null; loopTask = null;
                IsPlaying = false; paused = false;
                await ReleaseAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // A later Run whose program is NOT a game: stop, then take the canvas off the page so a
    // console program never sits under a frozen frame from the previous run.
    public async Task ClearAsync()
    {
        await StopAsync();
        session = null; error = null; notice = null; lines = new(); paused = false;
        StateHasChanged();
    }

    // Returns only once the loop has actually finished, so a caller that starts another one
    // (PlayAsync) or disposes the JS modules (DisposeAsync) cannot race the old loop's tail.
    public async Task StopAsync()
    {
        if (loop is null) return;
        CancellationTokenSource cts = loop;
        Task? running = loopTask;
        loop = null; loopTask = null;      // supersede FIRST: an inline continuation must see it
        cts.Cancel();
        IsPlaying = false;
        paused = false;
        if (running is not null)
        {
            try { await running; }
            catch (Exception ex) when (ex is OperationCanceledException or JSException
                                          or JSDisconnectedException or ObjectDisposedException) { }
        }
        cts.Dispose();
        await ReleaseAsync();
    }

    // Called by input.js on every visibilitychange while this stage holds the reference.
    // Hiding clears the keyboard (a key released in another window sends no keyup here, so it
    // would still read as held on return) but keeps the reference, or nothing would be
    // listening when the tab comes back.
    [JSInvokable]
    public async Task OnVisibility(bool hidden)
    {
        if (!IsPlaying || input is null) return;
        try
        {
            if (hidden) { paused = true; await input.InvokeVoidAsync("clear"); }
            else { await input.InvokeVoidAsync("attach", canvas, session!.Width, session.Height); paused = false; }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException
                                      or ObjectDisposedException) { }
        await InvokeAsync(StateHasChanged);
    }

    async Task ReleaseAsync()
    {
        if (input is null) return;
        try { await input.InvokeVoidAsync("release"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException
                                      or ObjectDisposedException) { }
    }

    // Nine slots per command; primitives only, so JS interop needs no converters.
    static object[] Flatten(IReadOnlyList<DrawCommand> commands)
    {
        var flat = new object[commands.Count * 9];
        for (int i = 0; i < commands.Count; i++)
        {
            DrawCommand c = commands[i];
            int o = i * 9;
            flat[o] = (int)c.Kind; flat[o + 1] = c.A; flat[o + 2] = c.B; flat[o + 3] = c.C; flat[o + 4] = c.D;
            flat[o + 5] = (int)c.Colour.R; flat[o + 6] = (int)c.Colour.G; flat[o + 7] = (int)c.Colour.B;
            flat[o + 8] = c.Text;
        }
        return flat;
    }

    static List<string> Tail(string console)
    {
        IReadOnlyList<string> all = OutputComparer.Lines(console);
        return all.Skip(Math.Max(0, all.Count - ShownLines)).ToList();
    }

    public async ValueTask DisposeAsync()
    {
        await StopAsync();                 // awaits the loop: nothing can call into the modules now
        if (active == this) active = null;
        self?.Dispose();                   // after StopAsync: release() has already dropped it in JS
        self = null;
        try
        {
            if (game is not null) await game.DisposeAsync();
            if (input is not null) await input.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
    }
}
