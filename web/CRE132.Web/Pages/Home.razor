@namespace CRE132.Web.Pages
@using CRE132.Engine
@using Microsoft.JSInterop
@implements IDisposable
@inject Samples SampleStore

@* The landing page: what the course is, on the left; what it builds, playing on the right.
   Every lesson link here is wired exactly like the sidebar contents links - an href plus an
   @onclick that preventDefaults and calls back into Index.Go. Index's comment explains why the
   handler is the path that matters: a Blazor-intercepted hash click raises neither
   LocationChanged nor hashchange, so the href on its own would move the URL and nothing else. *@
<main class="home">
    <section class="hero">
        <div class="hero-text">
            <h1>CRE132: Fundamentals of Game Programming</h1>
            <p class="blurb">
                Learn C# by writing programs that run right here in your browser — nothing to
                install, and your work saves as you go.
            </p>
            <p class="cta-row">
                <a class="cta" href="@("#" + FirstLesson)" @onclick="() => OnNavigate.InvokeAsync(FirstLesson)" @onclick:preventDefault>▶ Start Lesson 0</a>
            </p>
            <p class="hero-aside"><a href="playground">Or open the free-form playground →</a></p>
        </div>

        <div class="hero-preview">
            @* The game starts itself as soon as the page has rendered, so GameStage's own ■ Stop
               is the only control a visitor needs to pause it - and OnReplay is the way back:
               with a handler passed, a stopped stage offers "▶ Run again", which runs the same
               start path from the beginning. Lesson pages pass no OnReplay and show no button. *@
            <GameStage @ref="stage" OnReplay="StartPreviewAsync" />
            @if (notice is not null)
            {
                <p class="notice">@notice</p>
            }
            else
            {
                <p class="hero-hint">On a keyboard: click the canvas first — <b>W</b> / <b>S</b> move the left paddle, <b>↑</b> / <b>↓</b> the right.</p>
            }
            <p class="caption">What you'll build: Pong, by Lesson 19 — then Snake in Part 3.</p>
        </div>
    </section>

    @* The columns and the lesson sidebar are the same list: PartList renders both, so neither
       can drift from the other or from the catalog. *@
    <section class="parts">
        @foreach (Part part in WebCatalog.Parts)
        {
            <PartList Part="part" OnNavigate="OnNavigate" />
        }
    </section>
</main>

@code {
    [Parameter, EditorRequired] public EventCallback<string> OnNavigate { get; set; }

    const string FirstLesson = "0";
    const string PreviewSample = "s19-pong";

    GameStage? stage;
    string? notice;
    bool gone;                              // set by Dispose: this Home is off the page for good

    // firstRender only: PlayAsync hands the canvas element to JS, so it must already be in the
    // document. The stage stops itself when this component goes away (GameStage is
    // IAsyncDisposable), so clicking through to a lesson leaves no loop running, and Back
    // re-creates Home and starts the preview afresh.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await StartPreviewAsync();
    }

    // Also the ▶ Run again handler, and deliberately the SAME path rather than a resume: a fresh
    // GameSession is a fresh Pong, paddles centred and score zero. The bytes are cached by
    // Samples after the first fetch, so a replay is a load-and-start with no network in it, and
    // both guards below apply to a click exactly as they do to the first render.
    //
    // `gone` guards the window between the awaits below. A visitor who clicks Start Lesson 0
    // while the sample is still downloading has Home and its GameStage disposed FIRST, and the
    // continuation then resumes with a dead stage in hand. Measured, with the guard removed and
    // a 60 s delay in front of the fetch: the continuation does reach PlayAsync, which sets
    // itself as GameStage's static `active` and then fails at game.js reset - the canvas
    // ElementReference no longer resolves - so its own JSException catch returns with
    // IsPlaying false. Today that stops short of the real damage only because reset runs
    // BEFORE input.attach; attach is what sets input.js `running`, which swallows the arrow
    // keys and Space page-wide for as long as it is set. Nothing in GameStage promises that
    // ordering, and a dead stage should never be reached at all, so the guard is here rather
    // than a comment trusting two accidents to keep holding.
    async Task StartPreviewAsync()
    {
        try
        {
            byte[] program = await SampleStore.FetchAsync(PreviewSample);
            if (gone) return;
            GameSession session = GameSession.Start(ProgramLoader.FromBytes(program), "");
            if (!session.IsGame)
            {
                Notify();
                return;
            }
            await stage!.PlayAsync(session);
            if (gone) await stage.StopAsync();   // disposed mid-PlayAsync: leave no loop behind
        }
        catch (Exception)
        {
            // Deliberately every exception: the preview is decorative, and a corrupt or
            // renamed .bin must not leave the landing page in an invisible broken state with
            // the lesson columns unreachable under a Blazor error banner.
            Notify();
        }
    }

    void Notify()
    {
        if (gone) return;
        notice = "The preview could not load — the lessons still work.";
        StateHasChanged();
    }

    public void Dispose() => gone = true;
}
