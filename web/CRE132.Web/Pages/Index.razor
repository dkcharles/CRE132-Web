@page "/"
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.JSInterop

@if (current is null)
{
    <main class="placeholder">
        <h1>CRE132</h1>
        <p>Learn C# in your browser. Nothing to install — code runs right here in the page.</p>
        <nav class="contents-home">
            <ol>
                @foreach (Entry e in WebCatalog.Entries)
                {
                    <li><a href="@("#" + e.Id)" @onclick="() => Go(e.Id)" @onclick:preventDefault>@e.Title</a></li>
                }
            </ol>
        </nav>
        <p><a href="playground">Or open the free-form playground →</a></p>
    </main>
}
else
{
    <div class="page">
        <nav class="contents">
            <a class="home" href="#" @onclick="GoHome" @onclick:preventDefault>CRE132</a>
            <ol>
                @foreach (Entry e in WebCatalog.Entries)
                {
                    <li class="@(e.Id == current.Id ? "current" : "")">
                        <a href="@("#" + e.Id)" @onclick="() => Go(e.Id)" @onclick:preventDefault>@e.Title</a>
                    </li>
                }
            </ol>
        </nav>
        <LessonView Entry="@current" />
    </div>
}

@code {
    Entry? current;
    DotNetObjectReference<Index>? self;
    IJSObjectReference? nav;

    // The hash IS the router: #1 is Lesson 1, no hash is the contents. Pages serves only /
    // for this app, so hash addresses are the one deep-link scheme that cannot 404 on a
    // static host - the reason this site does not use path routes for lessons.
    protected override void OnInitialized() => Apply(Nav.Uri);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // hashchange covers anchor clicks (even those made before this line ran - the hash
        // they set is already reflected in Nav.Uri by the time OnInitialized read it),
        // Back/Forward, and manual URL edits. No per-anchor handlers to race with boot.
        self = DotNetObjectReference.Create(this);
        nav = await JS.InvokeAsync<IJSObjectReference>("import", "./js/nav.js");
        await nav.InvokeVoidAsync("listen", self);
    }

    [JSInvokable]
    public void OnHashChanged(string hash)
    {
        current = hash.Length > 1 ? WebCatalog.Find(hash[1..]) : null;
        StateHasChanged();
    }

    void Apply(string uri)
    {
        int at = uri.IndexOf('#');
        string hash = at >= 0 ? uri[(at + 1)..] : "";
        current = hash.Length == 0 ? null : WebCatalog.Find(hash);
    }

    // Navigation has THREE paths, each covering what the others cannot:
    //  - These click handlers: every normal click. They set `current` DIRECTLY rather than
    //    relying on any navigation event, because a Blazor-intercepted hash click raises
    //    NEITHER LocationChanged NOR hashchange (pushState fires no events) - preventDefault
    //    stops that interceptor and NavigateTo just keeps the URL in step.
    //  - The hashchange listener (nav.js): Back/Forward and hand-edited URLs.
    //  - Apply(Nav.Uri) in OnInitialized: a click made before Blazor booted - the native
    //    fragment jump already changed the URL by the time we first read it.
    void Go(string id)
    {
        Nav.NavigateTo("#" + id);
        current = WebCatalog.Find(id);
    }

    void GoHome()
    {
        Nav.NavigateTo(Nav.BaseUri);
        current = null;
    }

    public void Dispose() => self?.Dispose();
}
