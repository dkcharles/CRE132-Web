@page "/"
@implements IDisposable
@inject NavigationManager Nav

@if (current is null)
{
    <main class="placeholder">
        <h1>CRE132</h1>
        <p>Learn C# in your browser. Nothing to install — code runs right here in the page.</p>
        <nav class="contents-home">
            <ol>
                @foreach (Entry e in WebCatalog.Entries)
                {
                    <li><a href="@("#" + e.Id)" @onclick="() => Go(e.Id)" @onclick:preventDefault>@e.Title</a></li>
                }
            </ol>
        </nav>
        <p><a href="playground">Or open the free-form playground →</a></p>
    </main>
}
else
{
    <div class="page">
        <nav class="contents">
            <a class="home" href="#" @onclick="GoHome" @onclick:preventDefault>CRE132</a>
            <ol>
                @foreach (Entry e in WebCatalog.Entries)
                {
                    <li class="@(e.Id == current.Id ? "current" : "")">
                        <a href="@("#" + e.Id)" @onclick="() => Go(e.Id)" @onclick:preventDefault>@e.Title</a>
                    </li>
                }
            </ol>
        </nav>
        <LessonView Entry="@current" />
    </div>
}

@code {
    Entry? current;

    // The hash IS the router: #1 is Lesson 1, no hash is the contents. Pages serves only /
    // for this app, so hash addresses are the one deep-link scheme that cannot 404 on a
    // static host - the reason this site does not use path routes for lessons.
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Apply(Nav.Uri);
    }

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Apply(e.Location);
        StateHasChanged();
    }

    void Apply(string uri)
    {
        int at = uri.IndexOf('#');
        string hash = at >= 0 ? uri[(at + 1)..] : "";
        current = hash.Length == 0 ? null : WebCatalog.Find(hash);
    }

    // Blazor raises LocationChanged for NavigateTo and for popstate (Back/Forward), but NOT
    // for a plain anchor click that only changes the hash - the browser handles that natively
    // and the view never re-renders. Clicks therefore go through NavigateTo; the hrefs stay
    // so copy-link and middle-click still behave like links.
    void Go(string id) => Nav.NavigateTo("#" + id);

    void GoHome() => Nav.NavigateTo(Nav.BaseUri);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
