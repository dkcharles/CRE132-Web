@page "/playground"
@using CRE132.Engine
@inject CompilerLoader Compiler
@implements IDisposable

<main class="playground">
    <h1>Playground</h1>
    <p>Write a C# program and press Run. It compiles and runs right here in your browser.</p>

    <CodeEditor @ref="editor" EditorId="playground" InitialText="@source" />

    <details>
        <summary>Input — one line per <code>Console.ReadLine()</code></summary>
        <textarea class="stdin" rows="3" @bind="input"></textarea>
    </details>

    <div class="controls">
        <button @onclick="RunAsync" disabled="@busy">
            @(Compiler.IsLoading ? "Downloading compiler…" : busy ? "Running…" : "Run")
        </button>
    </div>

    <GameStage @ref="stage" />

    @if (errors is { Count: > 0 })
    {
        <ul class="errors">
            @foreach (var e in errors)
            {
                <li>Line @e.Line: @e.Message <span class="error-id">(@e.Id)</span></li>
            }
        </ul>
    }
    @if (notice is not null) { <p class="notice">@notice</p> }
    @if (output is not null)
    {
        <pre class="console">@ConsoleLines.Shown(output, showAll)</pre>
        @if (!showAll && ConsoleLines.IsCapped(output))
        {
            <button class="show-all" @onclick="() => showAll = true">Show all @ConsoleLines.Count(output) lines</button>
        }
    }
    @if (runError is not null) { <p class="run-error">@runError</p> }
</main>

@code {
    CodeEditor? editor;
    GameStage? stage;
    string source = "Console.WriteLine(\"Hello, CRE132!\");\n";
    string input = "";
    string? output;
    string? runError;
    string? notice;
    IReadOnlyList<CompileError>? errors;
    bool busy;
    bool showAll;      // the console shows the last 200 lines until the reader asks for the rest

    protected override void OnInitialized() => Compiler.StateChanged += StateHasChanged;

    public void Dispose() => Compiler.StateChanged -= StateHasChanged;

    async Task RunAsync()
    {
        busy = true;
        errors = null; output = null; runError = null; notice = null; showAll = false;
        try
        {
            source = await editor!.GetTextAsync();
            CompileResult result = await Compiler.CompileAsync(source);
            if (!result.Succeeded)
            {
                errors = result.Errors;
                await editor.SetErrorsAsync(errors!);
                return;
            }

            // A program that called Game.Run plays on the stage, which owns its own console;
            // anything else prints into the pane below.
            GameSession session = GameSession.Start(result.Run!, input);
            if (session.IsGame) { await stage!.PlayAsync(session); }
            else
            {
                await stage!.ClearAsync();
                output = session.Result.Output;
                runError = session.Result.Error;
            }
            await editor.SetErrorsAsync(Array.Empty<CompileError>());
        }
        // The compiler could not be fetched. Almost always a deploy landing under an open
        // page, which no retry fixes: the page itself is the stale part.
        catch (CompilerUnavailableException ex) { notice = ex.Message; }
        finally
        {
            busy = false;
        }
    }
}
