@namespace CRE132.Web.Pages
@using CRE132.Engine
@inject Samples SampleStore

<div class="runnable">
    <div class="pane">
        <div class="pane-label">The code</div>
        <pre class="listing"><code>@((MarkupString)Code)</code></pre>
    </div>
    @if (DeclaredInput is not null)
    {
        <details>
            <summary>Input — one line per <code>Console.ReadLine()</code></summary>
            <textarea class="stdin" rows="3" @bind="input"></textarea>
        </details>
    }
    @* A game keeps its own Run button above the stage: the console pane that normally carries
       one is hidden while the canvas is playing. *@
    @if (isGame)
    {
        <div class="controls">
            <button @onclick="RunAsync" disabled="@busy">@(busy ? "Running…" : "Run this")</button>
        </div>
    }
    <GameStage @ref="stage" />
    @if (!isGame)
    {
        <div class="pane">
            <div class="pane-label">
                Console — what it prints
                <button @onclick="RunAsync" disabled="@busy">@(busy ? "Running…" : "Run this")</button>
            </div>
            @if (notice is not null) { <p class="notice">@notice</p> }
            else if (output is null) { <div class="console empty">Press Run this to see the output.</div> }
            else
            {
                <pre class="console">@ConsoleLines.Shown(output, showAll)</pre>
                @if (!showAll && ConsoleLines.IsCapped(output))
                {
                    <button class="show-all" @onclick="() => showAll = true">Show all @ConsoleLines.Count(output) lines</button>
                }
            }
            @if (runError is not null) { <p class="run-error">@runError</p> }
        </div>
    }
    @if (Caption is { Length: > 0 }) { <p class="caption">@Caption</p> }
</div>

@code {
    [Parameter, EditorRequired] public string SampleId { get; set; } = default!;
    [Parameter, EditorRequired] public string Code { get; set; } = default!;
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? DeclaredInput { get; set; }

    GameStage? stage;
    bool isGame;
    string? output, runError, notice;
    string input = "";
    bool busy;
    bool showAll;      // the console shows the last 200 lines until the reader asks for the rest

    protected override void OnInitialized() => input = DeclaredInput ?? "";

    // Precompiled: fetching a few KB of bytes, never Roslyn. A reader who only presses Run
    // buttons downloads no compiler at all.
    async Task RunAsync()
    {
        busy = true; notice = null; runError = null; showAll = false;
        try
        {
            byte[] program = await SampleStore.FetchAsync(SampleId);
            GameSession session = GameSession.Start(ProgramLoader.FromBytes(program), input ?? "");
            isGame = session.IsGame;
            if (isGame) { output = null; runError = null; await stage!.PlayAsync(session); }
            else { await stage!.ClearAsync(); output = session.Result.Output; runError = session.Result.Error; }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException
                                      or Microsoft.JSInterop.JSException)
        {
            // The notice lives in the console pane, so a failed fetch must show that pane even
            // if the previous run was a game.
            isGame = false;
            notice = "Could not fetch this example just now — try again in a moment.";
        }
        finally { busy = false; }
    }
}
